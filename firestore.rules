// 동그란 말 공감 교실 — Firebase 프로젝트 pohang-empathy 보안 규칙
// Firestore → 규칙 탭의 내용을 모두 지우고 이 파일 전체를 붙여 넣은 뒤 [게시]를 누르세요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 수업 코드 → 수업 방 연결. 학생은 코드 하나만 읽기(목록 보기 불가), 쓰기는 만든 선생님만
    match /consultCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
                    && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // 수업 방: 만든 선생님만 읽기·쓰기
    match /consultRooms/{roomId} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
                    && request.resource.data.owner == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // 학생 기록: 학생은 열린 수업에 "보내기"만, 읽기·지우기는 그 선생님만, 고치기 불가
      match /responses/{rid} {
        function cRoom() { return get(/databases/$(database)/documents/consultRooms/$(roomId)).data; }
        function cSeat(d) {
          return d.classNo is string && d.classNo.size() <= 6
              && d.studentNo is int && d.studentNo >= 1 && d.studentNo <= 60
              && d.displayName is string && d.displayName.size() <= 3;
        }
        function cCheck(d) {
          return d.phase in ['pre', 'post']
              && d.keys().hasOnly(['phase','classNo','studentNo','displayName','mood','moodWord','items','note','createdAt'])
              && d.mood is int && d.mood >= 1 && d.mood <= 5
              && d.moodWord is string && d.moodWord.size() <= 10
              && d.items is list && d.items.size() == 6
              && d.note is string && d.note.size() <= 200;
        }
        function cActivity(d) {
          return d.phase == 'activity'
              && d.keys().hasOnly(['phase','classNo','studentNo','displayName','score','hits','answers','createdAt'])
              && d.score is int && d.score >= 0 && d.score <= 800
              && d.hits is map
              && d.answers is list && d.answers.size() <= 8;
        }
        allow create: if cRoom().open == true && cSeat(request.resource.data)
                      && (cCheck(request.resource.data) || cActivity(request.resource.data));
        allow read, delete: if request.auth != null && cRoom().owner == request.auth.uid;
        allow update: if false;
      }
    }

    // 그 밖의 모든 경로는 막음
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
